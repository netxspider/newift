# ==============================================================================
# Newift Automated News Intelligence, SEO & Publishing Pipeline Configuration
# ==============================================================================

# --- Sanity CMS Configuration ---
# Project ID and Dataset for your Sanity Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=kezbsr7k
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=kezbsr7k
SANITY_DATASET=production
SANITY_API_VERSION=2026-07-21

# REQUIRED for automatic publishing into Sanity:
# Generate at: https://www.sanity.io/manage/project/kezbsr7k/api#tokens
# Permissions needed: "Editor" (Create, edit, delete, publish documents & assets)
SANITY_API_WRITE_TOKEN=

# OPTIONAL: Webhook secret to trigger Next.js Instant Cache Revalidation (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# --- Google Gemini AI Configuration ---
# REQUIRED for advanced AI analytical synthesis & multi-turn fact structuring:
# Get free or pay-as-you-go key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend Website URL ---
NEXT_PUBLIC_SITE_URL=https://newift.com

# --- Pipeline Storage ---
# Local SQLite database path (records jobs, discovered clusters, and published history)
PIPELINE_DB_PATH=pipeline/storage/pipeline.db
